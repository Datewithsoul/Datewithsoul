// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  lineId        String?        @unique
  name          String
  email         String?        @unique
  phone         String?
  image         String?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]
  bookingGroups BookingGroup[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model ClassEvent {
  id               String       @id @default(uuid())
  name             String
  description      String?
  category         String?      @default("เวิร์กชอป")
  instructor       String       @default("ไม่ระบุผู้สอน")
  date             DateTime
  endDate          DateTime?
  startTime        String
  endTime          String
  price            Float
  totalSeats       Int
  learningOutcomes String[]     @default([])
  requirements     String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  bookings         Booking[]
  media            ClassMedia[]
}

model ClassMedia {
  id           String     @id @default(uuid())
  classEventId String
  classEvent   ClassEvent @relation(fields: [classEventId], references: [id], onDelete: Cascade)
  url          String
  type         String // "IMAGE" or "VIDEO"
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  classEventId   String
  classEvent     ClassEvent    @relation(fields: [classEventId], references: [id])
  status         BookingStatus @default(BOOKING)
  seats          Int           @default(1)
  totalPrice     Float
  bookingGroupId String?
  bookingGroup   BookingGroup? @relation(fields: [bookingGroupId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payment        Payment?
}

enum BookingStatus {
  BOOKING
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  CANCELLED
}

model BookingGroup {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  bookings   Booking[]
  payment    Payment?
  totalPrice Float
  status     BookingGroupStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

enum BookingGroupStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  CANCELLED
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String?       @unique
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  bookingGroupId String?       @unique
  bookingGroup   BookingGroup? @relation(fields: [bookingGroupId], references: [id])
  slipUrl        String?
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}
