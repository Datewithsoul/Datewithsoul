generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid())
  lineId           String?            @unique
  name             String
  email            String?            @unique
  role             Role               @default(CUSTOMER)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  image            String?
  phone            String?
  bookings         Booking[]
  bookingGroups    BookingGroup[]
  approvedRequests ChangeRequest[]    @relation("ApprovedRequests")
  changeRequests   ChangeRequest[]
  notifications    NotificationLog[]
  paymentReviews   PaymentReviewLog[]
}

model ClassEvent {
  id                String           @id @default(uuid())
  name              String
  description       String?
  date              DateTime
  startTime         String
  endTime           String
  price             Float
  totalSeats        Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  instructor        String           @default("ไม่ระบุผู้สอน")
  category          String?          @default("เวิร์กชอป")
  endDate           DateTime?
  learningOutcomes  String[]         @default([])
  requirements      String[]         @default([])
  status            ClassEventStatus @default(PUBLISHED)
  googleMapUrl      String?
  locationName      String?          @default("Date with Soul Love")
  bookings          Booking[]
  originalRequests  ChangeRequest[]  @relation("OriginalEvent")
  requestedRequests ChangeRequest[]  @relation("RequestedEvent")
  media             ClassMedia[]
}

model ClassMedia {
  id           String     @id @default(uuid())
  classEventId String
  url          String
  type         String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  classEvent   ClassEvent @relation(fields: [classEventId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String            @id @default(uuid())
  userId         String
  classEventId   String
  status         BookingStatus     @default(PENDING_PAYMENT)
  seats          Int               @default(1)
  totalPrice     Float
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  bookingGroupId String?
  changeCount    Int               @default(0)
  attended       Boolean           @default(false)
  note           String?
  bookingGroup   BookingGroup?     @relation(fields: [bookingGroupId], references: [id])
  classEvent     ClassEvent        @relation(fields: [classEventId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  changeRequests ChangeRequest[]
  notifications  NotificationLog[]
  payment        Payment?
}

model BookingGroup {
  id         String             @id @default(uuid())
  userId     String
  totalPrice Float
  status     BookingGroupStatus @default(PENDING_PAYMENT)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  bookings   Booking[]
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment    Payment?
}

model Payment {
  id             String             @id @default(uuid())
  bookingId      String?            @unique
  slipUrl        String?
  status         PaymentStatus      @default(UNPAID)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bookingGroupId String?            @unique
  bookingGroup   BookingGroup?      @relation(fields: [bookingGroupId], references: [id])
  booking        Booking?           @relation(fields: [bookingId], references: [id])
  reviewLogs     PaymentReviewLog[]
}

model NotificationLog {
  id        String   @id @default(uuid())
  bookingId String?
  userId    String
  type      String
  message   String?
  sentAt    DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentReviewLog {
  id             String        @id @default(uuid())
  paymentId      String
  reviewerId     String
  previousStatus PaymentStatus
  newStatus      PaymentStatus
  reason         String?
  createdAt      DateTime      @default(now())
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewer       User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

model ChangeRequest {
  id               String        @id @default(uuid())
  bookingId        String
  userId           String
  type             RequestType
  originalEventId  String?
  requestedEventId String?
  originalPrice    Float?
  newPrice         Float?
  priceDifference  Float?
  customerReason   String?
  status           RequestStatus @default(PENDING)
  adminDecision    String?
  adminReason      String?
  approvedById     String?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  approvedBy       User?         @relation("ApprovedRequests", fields: [approvedById], references: [id])
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  originalEvent    ClassEvent?   @relation("OriginalEvent", fields: [originalEventId], references: [id])
  requestedEvent   ClassEvent?   @relation("RequestedEvent", fields: [requestedEventId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageTemplate {
  id          String   @id @default(uuid())
  content     String
  updatedAt   DateTime @updatedAt
  category    String
  createdAt   DateTime @default(now())
  description String?
  enabled     Boolean  @default(true)
  key         String   @unique
  title       String
  variables   String[] @default([])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ClassEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  CHANGE_REQUESTED
  CANCELLATION_REQUESTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum BookingGroupStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REFUND_PENDING
  REFUNDED
  REJECTED
}

enum RequestType {
  CANCELLATION
  COURSE_CHANGE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}
